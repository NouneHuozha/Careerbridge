# Runtime PostgreSQL connection. Use Neon's pooled URL in deployed environments.
DATABASE_URL=postgresql://localhost:5432/careerbridge

# Direct/unpooled PostgreSQL URL used only by Drizzle Kit migrations.
DATABASE_URL_UNPOOLED=postgresql://localhost:5432/careerbridge

# Clerk development instance
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Set locally by the project owner for the one-time Pathways admin bootstrap.
CAREERBRIDGE_OWNER_CLERK_ID=
