{
  "servers": {
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "watermelon": {
      "type": "http",
      "url": "https://mcp.watermelon.sh/mcp"
    },
    "mobbin": {
      "type": "http",
      "url": "https://api.mobbin.com/mcp"
    },
    "twentyFirst": {
      "type": "http",
      "url": "https://21st.dev/api/mcp",
      "headers": {
        "x-api-key": "${env:API_KEY_21ST}"
      }
    },
    "iconoteka": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "iconoteka-mcp"]
    }
  }
}
