  "revision": {
    "title": "Ishan Uday Special Scholarship Scheme for North Eastern Region",
    "summary": "UGC scholarship support for eligible North Eastern Region students already admitted to first-year full-time undergraduate study.",
    "description": "Passing Class XII is a prerequisite, not a stand-alone application route: UGC says applicants must already be admitted to the first year of a recognized full-time undergraduate degree. UGC lists financial assistance of Rs 80,000 per year. The NSP 2026-27 scheme listing shows student applications open from 16 September to 30 November 2026; check the current portal details before applying.",
    "publicationStatus": "draft",
    "dataClassification": "real",
    "verificationStatus": "pending_review",
    "scholarship": {
      "category": "Northeast region",
      "provider": "University Grants Commission",
      "support": "UGC lists financial assistance of Rs 80,000 per annum for eligible students.",
      "studyLevels": [
        "undergraduate"
      ],
      "eligibilityRegions": [
        "Arunachal Pradesh",
        "Assam",
        "Manipur",
        "Meghalaya",
        "Mizoram",
        "Nagaland",
        "Sikkim",
        "Tripura"
      ],
      "status": "open",
      "officialUrl": "https://www.ugc.gov.in/Scholarships/stu_Scholarship5",
      "detail": {
        "eligibility": [
          {
            "title": "Already admitted to first-year undergraduate study",
            "description": "UGC says applicants must have passed Class XII or equivalent from a recognized board at a school in the North Eastern Region and already be admitted to the first year of a recognized full-time undergraduate degree. UGC's guidelines also require a valid domicile certificate from a North Eastern state and parental income below Rs 4.5 lakh per year. Class XII completion alone is not enough; check current eligible institution and programme conditions."
          }
        ],
        "benefitNotes": [
          "UGC lists Rs 80,000 per year; the scheme guidelines express this as Rs 8,000 per month for 10 months. Confirm current award terms in the latest NSP documents."
        ],
        "applicationMethod": "The NSP 2026-27 scheme listing shows student applications open from 16 September through 30 November 2026. Recheck the live scheme page before submitting."
      }
    },
